{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh:release:external-acceptance:v1",
  "title": "Mesh external release acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptanceMilestone",
    "sourceSha",
    "releaseTag",
    "status",
    "testedAt",
    "expiresAt",
    "operator",
    "results",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "acceptanceMilestone": { "type": ["string", "null"], "enum": [null, "R2", "R4"] },
    "sourceSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "releaseTag": { "type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][0-9A-Za-z.-]+)?$" },
    "status": { "enum": ["not-run", "passed", "failed", "blocked"] },
    "testedAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "operator": { "type": ["string", "null"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "environment", "notes", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "status": { "enum": ["not-run", "passed", "failed", "blocked"] },
          "environment": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
            "uniqueItems": true
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "bytes", "mediaType", "collectedAt", "sanitized", "resultIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "collectedAt": { "type": "string", "format": "date-time" },
          "sanitized": { "const": true },
          "resultIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
