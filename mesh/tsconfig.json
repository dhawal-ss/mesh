{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mesh/matrix-voice-runtime": ["src/lib/matrix-voice-runtime.contract.ts"],
      "@mesh/legacy-voice-runtime": ["src/lib/legacy-voice-runtime.contract.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/lib/livekit-voice.ts",
    "src/lib/livekit-voice.test.ts",
    "src/lib/voice-engine.ts",
    "src/lib/voice-engine.test.ts",
    "src/lib/voice-peer.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
