# Public, non-secret community-service identity. Replace these examples before
# setup. The Matrix server name is permanent once accounts exist.
MESH_SERVER_NAME=community.example
MESH_HOMESERVER_HOST=matrix.community.example
MESH_RTC_HOST=rtc.community.example
MESH_RTC_ENABLED=0
MESH_PUBLIC_ENABLED=0
MESH_REGISTRATION_ENABLED=1
MESH_ABUSE_EMAIL=abuse@community.example
MESH_OPERATOR_LOCALPART=operator
ACME_EMAIL=admin@community.example

# setup.sh replaces these examples with the current host account identity so
# bind-mounted Synapse files remain private and readable after migration.
MESH_RUNTIME_UID=501
MESH_RUNTIME_GID=20

# Keep Synapse private on the Mac. Caddy is the only public HTTP entry point.
SYNAPSE_CONTROL_BIND=127.0.0.1
SYNAPSE_CACHE_FACTOR=0.25

POSTGRES_USER=synapse
POSTGRES_DB=synapse

# setup.sh replaces these placeholders in the untracked .env file.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REGISTRATION_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
MACAROON_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
FORM_SECRET=REPLACE_WITH_RANDOM_SECRET
MESH_ADMISSION_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
# start.sh replaces the token after creating this dedicated, non-admin service
# account. Its authority comes only from explicit room membership and power.
MESH_ADMISSION_SERVICE_USER_ID=@mesh-admission-service:community.example
MESH_ADMISSION_SERVICE_ACCESS_TOKEN=REPLACE_DURING_FIRST_START

# Backup retention is applied after each successful local/offsite backup.
MESH_LOCAL_BACKUP_KEEP_DAILY=7
MESH_LOCAL_BACKUP_KEEP_WEEKLY=4
MESH_OFFSITE_BACKUP_KEEP_DAILY=30
MESH_OFFSITE_BACKUP_KEEP_WEEKLY=12
