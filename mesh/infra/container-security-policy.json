{
  "schemaVersion": 6,
  "scopePolicy": {
    "callPathComposeDirectories": [
      "infra/matrixrtc"
    ]
  },
  "scannerPolicy": {
    "candidateOutage": "fail-closed",
    "developmentOutage": "blocked-unavailable",
    "grypeVersion": "v0.116.1",
    "severityCutoff": "high",
    "onlyFixable": true,
    "database": {
      "sourceOrigin": "https://grype.anchore.io/databases/",
      "maxAgeHours": 120,
      "requireValid": true,
      "requireHashValidation": true
    }
  },
  "sbomPolicy": {
    "syftVersion": "v1.50.0",
    "format": "CycloneDX",
    "specVersion": "1.7",
    "minimumComponents": 1,
    "maxScanSkewMinutes": 60
  },
  "signatureDiscoveryPolicy": {
    "cosignVersion": "v3.0.6",
    "mode": "discovery-only",
    "identityRegexp": "^.+$",
    "issuerRegexp": "^https://.+$",
    "maxPayloadBytes": 1048576,
    "maxSignatures": 64,
    "requiresReviewer": true,
    "trustedForRelease": false
  },
  "meshCandidateTrustPolicy": {
    "cosignVersion": "v3.0.6",
    "mode": "keyless-github-actions",
    "identityRegexp": "^https://github\\.com/dhawal-ss/mesh/\\.github/workflows/container-candidates\\.yml@refs/heads/(main|beta/production-readiness-2026-08)$",
    "issuer": "https://token.actions.githubusercontent.com",
    "maxPayloadBytes": 1048576,
    "maxSignatures": 16,
    "trustedForCandidate": true,
    "trustedForRelease": false
  },
  "requiredUpdateRegressions": [
    "disposable-federation",
    "backup",
    "restore",
    "health",
    "cleanup"
  ],
