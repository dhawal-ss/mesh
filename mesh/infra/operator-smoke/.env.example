# Public, non-secret production smoke-test configuration.
# Copy this file outside Git, replace every placeholder, and pass that path to
# scripts/operator-smoke.ps1. Never add access tokens, passwords, API keys, or
# bearer tokens to this file; inject those through the process environment.

MESH_SMOKE_MATRIX_SERVER_NAME=example.com
MESH_SMOKE_HOMESERVER_URL=https://matrix-client.example.com
MESH_SMOKE_EXPECTED_SERVER_SOFTWARE=Synapse
MESH_SMOKE_EXPECTED_SERVER_VERSION=1.157.2
MESH_SMOKE_EXPECTED_USER_ID=@mesh-smoke:example.com

MESH_SMOKE_MAS_ISSUER=https://auth.example.com/
MESH_SMOKE_MAS_METADATA_URL=https://auth.example.com/.well-known/openid-configuration

MESH_SMOKE_ENCRYPTED_ROOM_ID=!replace-with-encrypted-room:example.com
MESH_SMOKE_MEDIA_MXC=mxc://example.com/replace-with-small-test-object
MESH_SMOKE_MEDIA_MAX_BYTES=1048576

# R3 voice acceptance only. Omit these four settings from the operator-owned
# R2 text/community configuration.
MESH_SMOKE_MATRIXRTC_SERVICE_URL=https://matrix-rtc.example.com/livekit/jwt
MESH_SMOKE_SFU_URL=wss://matrix-rtc.example.com/livekit/sfu

# The UDP URL is used for a real authenticated RFC 5766 Allocate. The TLS URL
# is checked for trusted TLS transport reachability only; release acceptance
# still requires a real Mesh call forced through a TURN/TLS relay candidate.
MESH_SMOKE_TURN_URL=turn:turn.example.com:3478?transport=udp
MESH_SMOKE_TURN_TLS_URL=turns:turn.example.com:5349?transport=tcp

# These operator-owned endpoints must return JSON. Backup status:
# {"status":"ok","lastSuccessfulAt":"2026-07-24T12:00:00Z"}
# Monitoring health: {"status":"ok"}
MESH_SMOKE_BACKUP_STATUS_URL=https://ops.example.com/mesh/backup-status
MESH_SMOKE_BACKUP_MAX_AGE_MINUTES=1440
MESH_SMOKE_MONITORING_HEALTH_URL=https://ops.example.com/mesh/health

# Required only for -Online. Inject them into the process environment from the
# operator secret store; do not add them above or to another tracked file:
# MESH_SMOKE_MATRIX_ACCESS_TOKEN
# MESH_SMOKE_TURN_USERNAME
# MESH_SMOKE_TURN_PASSWORD
#
# Optional bearer tokens for the operator-owned status endpoints:
# MESH_SMOKE_BACKUP_BEARER_TOKEN
# MESH_SMOKE_MONITORING_BEARER_TOKEN
