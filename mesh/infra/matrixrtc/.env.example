# Copy to an untracked operator-only file and replace every placeholder.
# Never commit the resulting API key or secret.
MATRIXRTC_CONTROL_BIND=127.0.0.1
MATRIXRTC_METRICS_BIND=127.0.0.1
MATRIXRTC_TURN_TLS_BIND=127.0.0.1
# Host-side control ports may be changed for isolated local validation. Keep
# the production values at their defaults because the proxy/runbook target
# these loopback listeners.
MATRIXRTC_LIVEKIT_HTTP_PORT=7880
MATRIXRTC_AUTH_HTTP_PORT=8080
MATRIXRTC_METRICS_PORT=6789

# Matrix server name that hosts /.well-known/matrix/client. This is usually the
# domain after ":" in local Matrix user IDs, not necessarily the homeserver API
# hostname.
MATRIXRTC_MATRIX_SERVER_NAME=example.com

# Public service URLs returned to clients and embedded in Mesh diagnostics.
MESH_MATRIXRTC_LIVEKIT_SERVICE_URL=https://matrix-rtc.example.com/livekit/jwt
MESH_MATRIXRTC_LIVEKIT_SFU_URL=wss://matrix-rtc.example.com/livekit/sfu

# Only these Matrix server names may create LiveKit rooms. Never use "*" in
# production. Federated guests may still join an already-created room.
MATRIXRTC_FULL_ACCESS_HOMESERVERS=example.com

# The TURN certificate must cover this separate hostname. The provided LiveKit
# config expects a trusted layer-4 terminator on public TCP 443 forwarding to
# the loopback-only plaintext TCP 5349 listener.
LIVEKIT_TURN_DOMAIN=turn.example.com

# Generate a unique key/secret pair in the production secrets manager.
LIVEKIT_API_KEY=REPLACE_WITH_RANDOM_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
