{
  "name": "mesh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:matrix": "tauri build",
    "tauri:build:lan": "tauri build --features legacy-p2p -- --no-default-features",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run && npm run test:rust:matrix && npm run test:rust:legacy",
    "test:rust:matrix": "cd src-tauri && cargo test --no-default-features --features matrix-backend --locked --jobs 1",
    "test:rust:legacy": "cd src-tauri && cargo test --no-default-features --features legacy-p2p --locked --jobs 1",
    "test:matrix-spike": "cd src-tauri && cargo test --no-default-features --features matrix-backend --locked --jobs 1 --test matrix_federation_live_tests -- --ignored --nocapture",
    "setup:matrix-spike:reset": "powershell -ExecutionPolicy Bypass -File ./infra/matrix-spike/setup.ps1 -Reset",
    "matrixrtc:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/matrixrtc-preflight.ps1",
    "operator:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/operator-smoke.ps1",
    "release:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/beta-release-preflight.ps1",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "events": "^3.3.0",
    "framer-motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-peer": "^9.11.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/simple-peer": "^9.11.9",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.2"
  }
}
