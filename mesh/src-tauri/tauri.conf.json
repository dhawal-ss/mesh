{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesh",
  "version": "0.2.0",
  "identifier": "com.mesh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mesh",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mesh"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../../LICENSE",
      "../../COPYRIGHT",
      "../THIRD_PARTY_NOTICES.md",
      "../release/installer-payload/"
    ],
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "windows/installer-coexistence.wxs"
        ],
        "componentRefs": [
          "MeshMsiInstallerMarker"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-coexistence.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
